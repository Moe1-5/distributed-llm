# Copy this file to .env and fill in real values.
# Never commit .env - it is gitignored.
# Every environment variable the app needs should be documented here.
# The backend loads this root .env automatically during local startup.

# App
APP_ENV=development

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_URL=http://127.0.0.1:8000

# Frontend / Electron renderer
VITE_BACKEND_URL=http://127.0.0.1:8000
VITE_BACKEND_WS_URL=ws://127.0.0.1:8000

# HuggingFace
# Prefer the in-app Hugging Face connection flow instead of manual token paste.
# Create a public Hugging Face OAuth app and set its client ID here.
DISTRIBLLM_HF_OAUTH_CLIENT_ID=
# Optional override for local Hugging Face auth storage.
DISTRIBLLM_HF_TOKEN_FILE=
# Optional fallback for diagnostics/manual token storage.
HF_TOKEN=

# Hivemind / DistribLLM
# Comma-separated bootstrap multiaddrs. Remote machines must use the public VPS address.
DISTRIBLLM_INITIAL_PEERS=
DISTRIBLLM_DHT_PREFIX=distribllm

# P2P transport mode:
# - auto: test direct reachability, then use a circuit relay when direct dialing fails.
# - direct: force direct LAN/public operation.
# - relay: force outbound relay operation for NAT/WSL workers.
DISTRIBLLM_NETWORK_MODE=auto

# Local Hivemind listening port. Use a fixed port for Windows/WSL direct mode.
# Port 0 selects a random port and is suitable when relay fallback is available.
DISTRIBLLM_P2P_PORT=0

# Optional comma-separated addresses advertised for direct connections.
# Windows/WSL LAN example: /ip4/192.168.1.25/tcp/7100
# Requires DISTRIBLLM_P2P_PORT to be the same fixed non-zero port.
DISTRIBLLM_ANNOUNCE_MADDRS=

# Optional comma-separated project-owned relay multiaddrs.
# Example: /ip4/203.0.113.10/tcp/7001/p2p/<RELAY_PEER_ID>
DISTRIBLLM_TRUSTED_RELAYS=

# AutoNAT and automatic router port mapping help direct public reachability.
DISTRIBLLM_AUTO_NAT=true
DISTRIBLLM_NAT_PORT_MAP=true

# AutoRelay lets private WSL/NAT workers reserve an outbound circuit path.
DISTRIBLLM_AUTO_RELAY=true
# Seconds to wait for a p2p-circuit address before startup fails explicitly.
DISTRIBLLM_RELAY_WAIT_TIMEOUT=60

# Remote expert attempts are retried only when failure is known to occur before
# worker execution. Ambiguous stream resets stop immediately to avoid duplicate work.
DISTRIBLLM_RPC_MAX_ATTEMPTS=2
DISTRIBLLM_RPC_INITIAL_BACKOFF_SECONDS=1
DISTRIBLLM_RPC_MAX_BACKOFF_SECONDS=4
DISTRIBLLM_RPC_SLOW_WARNING_SECONDS=30

# Worker-side public expert admission and cooperative execution bounds.
DISTRIBLLM_RPC_MAX_SEQUENCE_LENGTH=2048
DISTRIBLLM_RPC_MAX_BATCH_SIZE=4
DISTRIBLLM_RPC_MAX_TENSOR_BYTES=268435456
DISTRIBLLM_RPC_MAX_METADATA_BYTES=16380
DISTRIBLLM_RPC_MAX_CONCURRENT_FORWARDS=1
DISTRIBLLM_RPC_MAX_QUEUED_FORWARDS=2
DISTRIBLLM_RPC_QUEUE_WAIT_SECONDS=0.25
DISTRIBLLM_RPC_EXECUTION_TIMEOUT=120

# Set false to reject checkpoints that cannot use memory-efficient selective loading.
DISTRIBLLM_ALLOW_FULL_MODEL_FALLBACK=true

# Generator-side provider health. Selected route members are checked more often
# than standbys; readiness degrades only after consecutive failures.
DISTRIBLLM_HEALTH_SELECTED_INTERVAL=5
DISTRIBLLM_HEALTH_STANDBY_INTERVAL=15
# Relayed expert metadata may need several seconds for circuit setup.
DISTRIBLLM_HEALTH_PROBE_TIMEOUT=15
DISTRIBLLM_HEALTH_FAILURE_THRESHOLD=2
DISTRIBLLM_HEALTH_OFFLINE_THRESHOLD=4
DISTRIBLLM_HEALTH_RECOVERY_SUCCESSES=2
DISTRIBLLM_HEALTH_DHT_STALE_SECONDS=30
DISTRIBLLM_HEALTH_MAX_CONCURRENCY=4
DISTRIBLLM_HEALTH_JITTER_RATIO=0.15
DISTRIBLLM_HEALTH_SCHEDULER_INTERVAL=0.25
DISTRIBLLM_HEALTH_DISCOVERY_INTERVAL=2

# Worker DHT heartbeat. Expiry must exceed interval plus operation timeout.
DISTRIBLLM_DHT_EXPIRY_SECONDS=90
DISTRIBLLM_ANNOUNCE_INTERVAL_SECONDS=20
DISTRIBLLM_DHT_OPERATION_TIMEOUT=10
# Restart only the worker's DHT/RPC transport after consecutive remote lease
# refresh failures. Loaded model layers remain in memory during recovery.
DISTRIBLLM_DHT_RECOVERY_FAILURE_THRESHOLD=2
DISTRIBLLM_DHT_RECOVERY_COOLDOWN_SECONDS=60

# Complete-route failover. A replacement route is used only after a known
# pre-execution transport failure; ambiguous outcomes remain terminal.
DISTRIBLLM_ROUTE_MAX_ATTEMPTS=2
DISTRIBLLM_ROUTE_MAX_ALTERNATES=3
DISTRIBLLM_ROUTE_BACKOFF_SECONDS=0.25
DISTRIBLLM_ROUTE_QUARANTINE_SECONDS=15
DISTRIBLLM_ROUTE_ALLOW_DEGRADED=true

# Proof-of-useful-work incentives
# off preserves the original inference wire path. shadow signs and validates
# receipts without changing balances. credit appends verified ledger entries.
DISTRIBLLM_INCENTIVES_MODE=off
# Required for shadow/credit clients. Do not include a trailing slash.
DISTRIBLLM_SETTLEMENT_URL=
# Temporary connection and server errors use bounded exponential retries. Eight
# attempts with the defaults remain inside the five-minute receipt window.
DISTRIBLLM_SETTLEMENT_MAX_ATTEMPTS=8
DISTRIBLLM_SETTLEMENT_RETRY_BASE_SECONDS=1
DISTRIBLLM_SETTLEMENT_RETRY_MAX_SECONDS=30
DISTRIBLLM_SETTLEMENT_QUEUE_CAPACITY=1024
# Persistent local Ed25519 key. Leave empty to use ~/.distribllm/application-identity.json.
DISTRIBLLM_IDENTITY_PATH=
# Reward policy only accepts explicitly allowed model revisions.
DISTRIBLLM_MODEL_REVISION=main
# Settlement-service settings. The VPS service owns these values.
DISTRIBLLM_SETTLEMENT_DB=
DISTRIBLLM_RECEIPT_TIMESTAMP_WINDOW=300

# Credit-gated local developer API. Keep off until useful-work shadow evidence
# is approved. Electron chat remains free in every mode.
DISTRIBLLM_API_ACCESS_MODE=off
# Local WAL database containing hashed API keys and spend reservations.
DISTRIBLLM_API_ACCESS_DB=
DISTRIBLLM_API_PRICE_SCALE=1
DISTRIBLLM_API_CAPABILITY_TTL=120

# Strict generator readiness and deadline-bound UI snapshots.
DISTRIBLLM_GENERATOR_ROUTE_START_TIMEOUT=45
DISTRIBLLM_SERVING_PLAN_CACHE_SECONDS=5
