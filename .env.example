# Copy this file to .env and fill in real values.
# Never commit .env - it is gitignored.
# Every environment variable the app needs should be documented here.

# App
APP_ENV=development

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_URL=http://127.0.0.1:8000

# Frontend / Electron renderer
VITE_BACKEND_URL=http://127.0.0.1:8000
VITE_BACKEND_WS_URL=ws://127.0.0.1:8000

# HuggingFace
# Prefer the in-app settings flow for local token storage.
HF_TOKEN=

# Hivemind / DistribLLM
DISTRIBLLM_INITIAL_PEERS=
DISTRIBLLM_DHT_PREFIX=distribllm
