[Unit]
Description=DistribLLM useful-work settlement service
Documentation=file://@REPO_ROOT@/docs/USEFUL_WORK_INCENTIVES.md
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=distribllm-settlement
Group=distribllm-settlement
WorkingDirectory=@REPO_ROOT@/backend
EnvironmentFile=/etc/distribllm-settlement/service.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
StateDirectory=distribllm-settlement
StateDirectoryMode=0750
ExecStart=@REPO_ROOT@/deploy/vps/run-settlement.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/distribllm-settlement
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
