# Point every relay at both independent full DHT peers. Deploy a second relay
# under a different failure-domain label before claiming relay fault tolerance.
DISTRIBLLM_INFRA_ROLE=relay
DISTRIBLLM_INFRA_HOST=0.0.0.0
DISTRIBLLM_INFRA_PORT=7002
DISTRIBLLM_INFRA_ANNOUNCE_MADDR=/ip4/REPLACE_WITH_PUBLIC_IP/tcp/7002
DISTRIBLLM_INFRA_IDENTITY_PATH=/var/lib/distribllm-relay/relay.id
DISTRIBLLM_INFRA_STATUS_PATH=/run/distribllm-relay/status.json
DISTRIBLLM_INFRA_FAILURE_DOMAIN=REPLACE_WITH_HOST_OR_PROVIDER_LABEL
DISTRIBLLM_INFRA_INITIAL_PEERS=/ip4/REPLACE_WITH_DHT_ONE/tcp/7001/p2p/REPLACE_WITH_DHT_ONE_PEER_ID,/ip4/REPLACE_WITH_DHT_TWO/tcp/7001/p2p/REPLACE_WITH_DHT_TWO_PEER_ID
DISTRIBLLM_EXPECTED_PEER_ID=REPLACE_AFTER_FIRST_START
DISTRIBLLM_EXPECTED_HIVEMIND_VERSION=1.1.12
DISTRIBLLM_DEPLOY_COMMIT=
HIVEMIND_LOGLEVEL=DEBUG
GOLOG_LOG_LEVEL=relay=debug
