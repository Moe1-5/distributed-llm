# Install this role on at least two independent hosts/providers. On the second
# host, set INITIAL_PEERS to the first DHT peer's full public multiaddress.
DISTRIBLLM_INFRA_ROLE=dht
DISTRIBLLM_INFRA_HOST=0.0.0.0
DISTRIBLLM_INFRA_PORT=7001
DISTRIBLLM_INFRA_ANNOUNCE_MADDR=/ip4/REPLACE_WITH_PUBLIC_IP/tcp/7001
DISTRIBLLM_INFRA_IDENTITY_PATH=/var/lib/distribllm-dht/dht.id
DISTRIBLLM_INFRA_STATUS_PATH=/run/distribllm-dht/status.json
DISTRIBLLM_INFRA_FAILURE_DOMAIN=REPLACE_WITH_HOST_OR_PROVIDER_LABEL
DISTRIBLLM_INFRA_INITIAL_PEERS=
DISTRIBLLM_EXPECTED_PEER_ID=REPLACE_AFTER_FIRST_START
DISTRIBLLM_EXPECTED_HIVEMIND_VERSION=1.1.12
DISTRIBLLM_DEPLOY_COMMIT=
HIVEMIND_LOGLEVEL=DEBUG
GOLOG_LOG_LEVEL=dht=debug
