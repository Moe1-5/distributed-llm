DISTRIBLLM_PLACEMENT_HOST=127.0.0.1
DISTRIBLLM_PLACEMENT_PORT=7200
DISTRIBLLM_PLACEMENT_DB=/var/lib/distribllm-placement/placement.sqlite3
# Replace both placeholders with independent random values of at least 32 characters.
DISTRIBLLM_PLACEMENT_AUTH_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
DISTRIBLLM_PLACEMENT_TOKEN_SECRET=REPLACE_WITH_ANOTHER_32_RANDOM_CHARACTERS
DISTRIBLLM_PLACEMENT_STARTUP_TTL_SECONDS=90
DISTRIBLLM_PLACEMENT_ONLINE_TTL_SECONDS=300
DISTRIBLLM_DEPLOY_COMMIT=
DISTRIBLLM_FAILURE_DOMAIN=REPLACE_WITH_HOST_OR_PROVIDER_LABEL
