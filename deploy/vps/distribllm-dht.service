[Unit]
Description=DistribLLM full DHT bootstrap peer
Documentation=file://@REPO_ROOT@/docs/VPS_RELAY_OPERATIONS.md
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=distribllm-dht
Group=distribllm-dht
WorkingDirectory=@REPO_ROOT@/backend
EnvironmentFile=/etc/distribllm-dht/service.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
RuntimeDirectory=distribllm-dht
RuntimeDirectoryMode=0750
StateDirectory=distribllm-dht
StateDirectoryMode=0750
ExecStart=@REPO_ROOT@/deploy/vps/run-infrastructure-peer.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/distribllm-dht /run/distribllm-dht
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
